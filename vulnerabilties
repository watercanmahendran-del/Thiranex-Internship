import socket
from datetime import datetime


# Common ports and their services
COMMON_PORTS = {
    21: "FTP",
    22: "SSH",
    23: "Telnet",
    25: "SMTP",
    53: "DNS",
    80: "HTTP",
    110: "POP3",
    139: "NetBIOS",
    143: "IMAP",
    443: "HTTPS",
    445: "SMB",
    3306: "MySQL",
    3389: "RDP",
    8080: "HTTP-Proxy"
}


# Scan a single port
def scan_port(target, port):

    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

        # Wait maximum 1 second
        sock.settimeout(1)

        result = sock.connect_ex((target, port))

        sock.close()

        if result == 0:
            return True

        return False

    except Exception:
        return False


# Check the target
def vulnerability_scan(target):

    print("\n======================================")
    print("       VULNERABILITY SCANNER")
    print("======================================")

    print("Target:", target)
    print("Started:", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    open_ports = []

    print("\nScanning ports...\n")

    # Scan common ports
    for port, service in COMMON_PORTS.items():

        print(f"Checking port {port} ({service})...", end=" ")

        if scan_port(target, port):

            print("OPEN")

            open_ports.append((port, service))

        else:

            print("CLOSED")

    # Display results
    print("\n======================================")
    print("           SCAN RESULTS")
    print("======================================")

    if len(open_ports) == 0:

        print("No common open ports detected.")

    else:

        print("\nOpen Ports:")

        for port, service in open_ports:

            print(f"Port {port} - {service}")

    # Basic vulnerability checks
    print("\n======================================")
    print("       BASIC SECURITY CHECKS")
    print("======================================")

    vulnerabilities = []

    for port, service in open_ports:

        # Telnet
        if port == 23:

            vulnerabilities.append(
                "Telnet is open. Telnet sends communication without strong encryption."
            )

        # FTP
        elif port == 21:

            vulnerabilities.append(
                "FTP is open. FTP may transmit credentials without encryption."
            )

        # SMB
        elif port == 445:

            vulnerabilities.append(
                "SMB is open. Ensure SMB is properly secured and unnecessary exposure is avoided."
            )

        # RDP
        elif port == 3389:

            vulnerabilities.append(
                "RDP is open. Use strong authentication and restrict access."
            )

        # MySQL
        elif port == 3306:

            vulnerabilities.append(
                "MySQL is accessible. Database services should not be unnecessarily exposed."
            )

    if len(vulnerabilities) == 0:

        print("No basic issues detected by this scanner.")

    else:

        for vulnerability in vulnerabilities:

            print("[WARNING]", vulnerability)

    # Generate report
    generate_report(target, open_ports, vulnerabilities)


# Generate a text report
def generate_report(target, open_ports, vulnerabilities):

    filename = "vulnerability_report.txt"

    with open(filename, "w") as file:

        file.write("VULNERABILITY SCANNER REPORT\n")
        file.write("============================\n\n")

        file.write("Target: " + target + "\n")
        file.write(
            "Scan Time: "
            + datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            + "\n\n"
        )

        file.write("OPEN PORTS\n")
        file.write("----------\n")

        if len(open_ports) == 0:

            file.write("No common open ports detected.\n")

        else:

            for port, service in open_ports:

                file.write(
                    f"Port {port} - {service}\n"
                )

        file.write("\nSECURITY FINDINGS\n")
        file.write("-----------------\n")

        if len(vulnerabilities) == 0:

            file.write("No basic issues detected.\n")

        else:

            for vulnerability in vulnerabilities:

                file.write(
                    "[WARNING] " + vulnerability + "\n"
                )

    print("\nReport generated successfully!")
    print("File:", filename)


# Main program
print("======================================")
print("    PYTHON VULNERABILITY SCANNER")
print("======================================")

target = input("Enter target IP or hostname: ")

vulnerability_scan(target)
